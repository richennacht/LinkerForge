{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkerforge.org/schemas/openmm-run.v1.schema.json",
  "title": "LinkerForge replicated OpenMM run v1",
  "type": "object",
  "required": ["schema_version", "status", "input_pdb_sha256", "source_ids", "config", "config_sha256", "prepared_pdb_sha256", "system_xml_sha256", "preparation", "replicates", "software", "provenance", "evidence_quality", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "linkerforge.openmm-run.v1"},
    "status": {"enum": ["complete", "failed"]},
    "input_pdb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "config": {"type": "object"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prepared_pdb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "system_xml_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preparation": {
      "type": "object",
      "required": ["method", "original_atom_count", "protein_atom_count_after_repair_and_hydrogens", "terminal_atoms_added", "missing_residues_added", "non_terminal_heavy_atoms_added", "ph"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "original_atom_count": {"type": "integer", "minimum": 1},
        "protein_atom_count_after_repair_and_hydrogens": {"type": "integer", "minimum": 1},
        "terminal_atoms_added": {"type": "object"},
        "missing_residues_added": {"const": 0},
        "non_terminal_heavy_atoms_added": {"const": 0},
        "ph": {"type": "number", "minimum": 0, "maximum": 14}
      }
    },
    "replicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["replicate", "seed", "final_potential_energy_kj_mol", "trajectory_sha256", "state_csv_sha256", "structural_metrics_sha256", "structural_metric_frames", "structural_metric_summary", "final_pdb_sha256"],
        "properties": {
          "structural_metric_frames": {"type": "integer", "minimum": 1},
          "structural_metric_summary": {"type": "object"}
        }
      }
    },
    "software": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["commit_sha", "worktree_modified", "config_sha256"],
      "properties": {
        "commit_sha": {"type": "string", "minLength": 1},
        "worktree_modified": {"type": "boolean"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_quality": {"type": "string"},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
