{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richennacht/LinkerForge/schemas/dfl_merged_positive_candidate.v1.schema.json",
  "title": "Deduplicated DFL-positive candidate, not a training split",
  "type": "object",
  "required": ["schema_version", "record_type", "sequence_sha256", "sequence", "labels", "masked_disagreement_residues", "family_component_id", "source_observations", "provenance", "training_eligibility"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "deduplicated_dfl_positive_candidate"},
    "sequence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sequence": {"type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWYBXZJUO]+$"},
    "labels": {"type": "string", "pattern": "^[1x]+$"},
    "masked_disagreement_residues": {"type": "integer", "minimum": 0},
    "family_component_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
    "source_observations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["source", "source_id", "source_file_sha256", "positive_residues", "discarded_unverified_zero_residues"],
                "properties": {
                  "source": {"type": "string"},
                  "source_id": {"type": "string"},
                  "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "positive_residues": {"type": "integer", "minimum": 1},
                  "discarded_unverified_zero_residues": {"type": "integer", "minimum": 0}
                }, "additionalProperties": false}
    },
    "provenance": {
      "type": "object", "required": ["capacity_manifest_sha256", "config_hash", "schema_sha256", "pipeline_commit"],
      "properties": {
        "capacity_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pipeline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }, "additionalProperties": false
    },
    "training_eligibility": {"const": "candidate_not_B1_no_adjudicated_negatives_or_frozen_split"}
  },
  "additionalProperties": false
}
