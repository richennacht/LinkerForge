{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkerforge.org/schemas/public-multipair-structure-comparison.v1.schema.json",
  "title": "LinkerForge public multi-pair structure comparison v1",
  "type": "object",
  "required": ["schema_version", "status", "created_at", "evidence_quality", "domain_pair_count", "construct_count", "models_per_construct", "rankable_model_count", "records", "descriptive_top_by_mean_plddt", "descriptive_top_per_domain_pair", "selection_policy", "metric_interpretation", "provenance", "limitations", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "linkerforge.public-multipair-structure-comparison.v1"},
    "status": {"const": "complete"},
    "created_at": {"type": "string", "minLength": 1},
    "evidence_quality": {"const": "matched_three_public_domain_pair_descriptive_sensitivity"},
    "domain_pair_count": {"const": 3},
    "construct_count": {"const": 21},
    "models_per_construct": {"const": 5},
    "rankable_model_count": {"const": 105},
    "records": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"$ref": "#/$defs/result"}},
    "descriptive_top_by_mean_plddt": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/result"}},
    "descriptive_top_per_domain_pair": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/result"}},
    "selection_policy": {"type": "string", "minLength": 1},
    "metric_interpretation": {"type": "object", "required": ["mean_plddt", "linker_mean_plddt", "ptm", "mean_cross_domain_pae_angstrom"]},
    "provenance": {"type": "object", "required": ["panel_manifest", "panel_manifest_sha256", "existing_summary", "existing_summary_sha256", "commit_sha", "worktree_modified", "versions"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["construct_id", "domain_pair", "linker_id", "linker_sequence", "linker_length", "full_sequence_length", "mean_plddt", "domain_a_mean_plddt", "domain_b_mean_plddt", "ptm", "rank_1_model", "pdb", "pdb_sha256", "score_json", "score_json_sha256", "descriptive_mean_plddt_rank"],
      "properties": {
        "construct_id": {"type": "string", "minLength": 1},
        "domain_pair": {"type": "string", "minLength": 1},
        "linker_id": {"type": "string", "minLength": 1},
        "linker_sequence": {"type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]*$"},
        "linker_length": {"type": "integer", "minimum": 0},
        "full_sequence_length": {"type": "integer", "minimum": 2},
        "mean_plddt": {"type": "number", "minimum": 0, "maximum": 100},
        "linker_mean_plddt": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "ptm": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "mean_cross_domain_pae_angstrom": {"type": ["number", "null"], "minimum": 0},
        "descriptive_mean_plddt_rank": {"type": "integer", "minimum": 1},
        "pdb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "score_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
