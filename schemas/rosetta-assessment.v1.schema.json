{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkerforge.org/schemas/rosetta-assessment.v1.schema.json",
  "title": "LinkerForge Rosetta linker assessment v1",
  "type": "object",
  "required": ["schema_version", "status", "input_pdb_sha256", "source_ids", "protocol_sha256", "config_sha256", "linker_range", "models", "passing_models", "command", "provenance", "evidence_quality", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "linkerforge.rosetta-assessment.v1"},
    "status": {"const": "complete"},
    "input_pdb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "linker_range": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
    "models": {"type": "array", "minItems": 1},
    "passing_models": {"type": "integer", "minimum": 0},
    "command": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "required": ["commit_sha", "worktree_modified", "config_sha256", "versions"],
      "properties": {
        "commit_sha": {"type": "string", "minLength": 1},
        "worktree_modified": {"type": "boolean"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "versions": {"type": "object", "minProperties": 1}
      }
    },
    "evidence_quality": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
