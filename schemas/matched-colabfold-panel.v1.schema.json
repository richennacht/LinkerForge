{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkerforge.org/schemas/matched-colabfold-panel.v1.schema.json",
  "title": "Matched ColabFold public baseline panel v1",
  "type": "object",
  "required": ["schema_version", "created_at", "purpose", "evidence_quality", "source_ids", "public_sources", "records", "existing_matched_candidate", "fasta_sha256", "planned_settings", "provenance", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "linkerforge.matched-colabfold-panel.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "purpose": {"type": "string", "minLength": 1},
    "evidence_quality": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "public_sources": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "existing_matched_candidate": {"type": "object"},
    "fasta_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planned_settings": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["commit_sha", "worktree_modified", "config_sha256", "versions"],
      "properties": {
        "commit_sha": {"type": "string", "minLength": 1},
        "worktree_modified": {"type": "boolean"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "versions": {"type": "object", "minProperties": 1}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
