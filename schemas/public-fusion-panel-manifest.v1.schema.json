{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkerforge.org/schemas/public-fusion-panel-manifest.v1.schema.json",
  "title": "Public fusion detector sensitivity panel manifest v1",
  "type": "object",
  "required": ["schema_version", "record_type", "evidence_quality", "source_ids", "provenance", "purpose", "records", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "public_fusion_linker_detector_sensitivity_panel"},
    "evidence_quality": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "required": ["commit_sha", "worktree_modified", "config_sha256", "versions"],
      "properties": {
        "commit_sha": {"type": "string", "minLength": 1},
        "worktree_modified": {"type": "boolean"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "versions": {"type": "object", "minProperties": 1}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
