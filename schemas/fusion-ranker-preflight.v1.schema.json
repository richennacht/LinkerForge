{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkerforge.org/schemas/fusion-ranker-preflight.v1.schema.json",
  "title": "LinkerForge fusion-ranker dataset preflight v1",
  "type": "object",
  "required": ["schema_version", "status", "record_count", "label_counts", "cluster_count", "failures", "training_authorized", "evidence_quality", "source_ids", "provenance", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "linkerforge.fusion-ranker-preflight.v1"},
    "status": {"enum": ["passed", "failed_closed", "source_inventory_only"]},
    "record_count": {"type": "integer", "minimum": 0},
    "label_counts": {"type": "object"},
    "source_inventory_counts": {"type": "object"},
    "cluster_count": {"type": "integer", "minimum": 0},
    "failures": {"type": "array", "items": {"type": "string"}},
    "training_authorized": {"type": "boolean"},
    "evidence_quality": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "required": ["commit_sha", "worktree_modified", "config_sha256", "versions"],
      "properties": {
        "commit_sha": {"type": "string", "minLength": 1},
        "worktree_modified": {"type": "boolean"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "versions": {"type": "object", "minProperties": 1}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
