{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkerforge.org/schemas/protected-site-assessment.v1.schema.json",
  "title": "LinkerForge protected-site spatial assessment v1",
  "type": "object",
  "required": ["schema_version", "pdb_sha256", "source_ids", "boundaries", "site_expression", "measurements", "software", "provenance", "evidence_quality", "threshold_status", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "linkerforge.protected-site-assessment.v1"},
    "pdb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "boundaries": {"type": "object"},
    "site_expression": {"type": "string", "minLength": 1},
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain", "domain_residue", "fusion_residue", "residue_name", "residue_sasa_angstrom2", "relative_sasa", "linker_contact_under_4_angstrom"],
        "properties": {
          "domain": {"enum": ["A", "B"]},
          "domain_residue": {"type": "integer", "minimum": 1},
          "fusion_residue": {"type": "integer", "minimum": 1},
          "relative_sasa": {"type": "number", "minimum": 0},
          "linker_contact_under_4_angstrom": {"type": "boolean"}
        }
      }
    },
    "software": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["commit_sha", "worktree_modified", "config_sha256"],
      "properties": {
        "commit_sha": {"type": "string", "minLength": 1},
        "worktree_modified": {"type": "boolean"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_quality": {"type": "string", "minLength": 1},
    "threshold_status": {"const": "not_frozen"},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
